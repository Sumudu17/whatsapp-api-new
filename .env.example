PORT=4000
LOG_LEVEL=info
SESSION_SECRET=
WWEBJS_AUTH_PATH=
AUTO_INIT=true
API_AUTH_REQUIRED=false

# Needed when using nginx/reverse proxy (prevents express-rate-limit warning/error)
TRUST_PROXY=1

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=whatsapp_web_js
DB_CONNECTION_LIMIT=10
DB_SSL=false

ADMIN_EMAIL=

OTP_PEPPER=
OTP_EXPIRES_MINUTES=10
OTP_RESEND_MIN_SECONDS=60
OTP_MAX_INVALID_ATTEMPTS=5

AUTO_INIT_MAX_WHATSAPP_CLIENTS=5
AUTO_INIT_STAGGER_MS=3000
WHATSAPP_INIT_RETRIES=2
WHATSAPP_INIT_RETRY_DELAY_MS=3000
WHATSAPP_INIT_WAIT_FOR_STATE_MS=60000
