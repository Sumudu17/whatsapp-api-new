PORT=4000
LOG_LEVEL=info
APP_USERNAME=admin
APP_PASSWORD=change_me
DEFAULT_TO=+94XXXXXXXXX
WWEBJS_CLIENT_ID=api
WWEBJS_AUTH_PATH=
AUTO_INIT=true
API_AUTH_REQUIRED=false
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-key-here
SMTP_FROM=your-email@gmail.com
ALERT_EMAIL_TO=your-email@gmail.com

# MySQL (required for multi-user)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASS=your-mysql-password
MYSQL_DB=whatsapp_web_js
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

# Admin email (used for critical notifications)
ADMIN_EMAIL=your-admin-email@gmail.com

# OTP security
OTP_PEPPER=change_me_to_a_long_random_secret
OTP_EXPIRES_MINUTES=10
OTP_RESEND_MIN_SECONDS=60
OTP_MAX_INVALID_ATTEMPTS=5

# Auto reconnect (server restart)
# On boot, backend will initialize active users from whatsapp_sessions
AUTO_INIT_MAX_WHATSAPP_CLIENTS=5
