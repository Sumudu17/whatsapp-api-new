# --- Server ---
PORT=4000
LOG_LEVEL=info
# Generate a long random string for production, e.g. openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Optional: override LocalAuth folder (default: ./.wwebjs_auth under project root)
WWEBJS_AUTH_PATH=

AUTO_INIT=true
API_AUTH_REQUIRED=false

# Behind nginx: trust first proxy hop (recommended). Use 0/false if not behind a proxy.
TRUST_PROXY=1

# --- SMTP (registration OTP, password reset, alerts) ---
# Gmail example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="WhatsApp Web API <your-account@gmail.com>"
# Brevo example (uncomment and use instead of Gmail if needed):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email@gmail.com
# SMTP_PASS=your_brevo_smtp_key
# SMTP_FROM=your-brevo-login-email@gmail.com

# Comma-separated alert recipients (must be real email addresses, not phone numbers).
# Used for disconnect / not-ready alerts and POST /api/alerts/test.
# Merged with ADMIN_EMAIL + ADMIN_EMAILS (duplicates removed).
ALERT_EMAIL_TO=anuruddhads@gmail.com,071sumudu@gmail.com

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=wa_user
DB_PASSWORD=your_db_password
DB_NAME=whatsapp_web_js
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Legacy aliases (optional; used if DB_* unset): MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASS, MYSQL_DB

# --- Admin: disconnect email alerts + /admin UI + GET /api/admin/accounts ---
# Login email must match ADMIN_EMAIL or ADMIN_EMAILS (case-insensitive) for /admin access.
# All addresses below also receive WhatsApp disconnect and not-ready alert emails.
ADMIN_EMAIL=anuruddhads@gmail.com
# Extra admins: comma-separated (spaces after commas are trimmed)
ADMIN_EMAILS=071sumudu@gmail.com

# --- OTP (registration, email change, password reset) ---
# Use a long random secret; never commit real .env
OTP_PEPPER=change_me_random_pepper_string
OTP_EXPIRES_MINUTES=10
OTP_RESEND_MIN_SECONDS=60
OTP_MAX_INVALID_ATTEMPTS=5

# --- WhatsApp clients (multi-user / Puppeteer) ---
AUTO_INIT_MAX_WHATSAPP_CLIENTS=5
AUTO_INIT_STAGGER_MS=3000
WHATSAPP_INIT_RETRIES=2
WHATSAPP_INIT_RETRY_DELAY_MS=3000
WHATSAPP_INIT_WAIT_FOR_STATE_MS=60000

# Optional: Puppeteer Chrome cache (e.g. on Linux server)
# PUPPETEER_CACHE_DIR=/home/ubuntu/.cache/puppeteer
